{
  "version": 2,
  "builds": [
    {
      "src": "backend-api/package.json",
      "use": "@vercel/node"
    },
    {
      "src": "frontend-web/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend-api/dist/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}