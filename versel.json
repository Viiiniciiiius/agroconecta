{
  "version": 2,
  "builds": [
    {
      "src": "backend-api/src/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend-web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend-api/src/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend-web/dist/index.html"
    }
  ]
}